{
  "name": "warlordsfork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Warlords remake on PlayCanvas \u2014 app shell, screen navigation and campaign save",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:deps && npm run check:names && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:names": "node scripts/check-names.mjs"
  },
  "dependencies": {
    "playcanvas": "2.22.4"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "dependency-cruiser": "18.4.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
